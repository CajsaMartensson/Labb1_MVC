@model List<Labb1_MVC.Models.Pokemon>

<div>
    <h1 class="display-4 fw-bold text-primary">Pokémon Explorer</h1>

    <form asp-controller="Pokemon" asp-action="Index" method="get">
        <label class="lead text-muted">Sök: <input type="text" name="query" /> </label>
        <button type="submit" class="btn btn-primary btn-lg shadow-sm px-4">Sök</button>
    </form>

    @if (Model != null)
    {

        <ul>

            @foreach (var pokemon in Model)
            {
                <li>
                    <a asp-controller="Pokemon" asp-action="Detail" asp-route-name="@pokemon.Name">@pokemon.Name</a>
                </li>
            }

        </ul>
    }

</div>
