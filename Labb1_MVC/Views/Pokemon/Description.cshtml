@model Labb1_MVC.Models.Pokemon;

<section>
    <h2>@Html.DisplayFor(model => model.Name)</h2>
    <h3>@Html.DisplayFor(model => model.Type)</h3>
    <p>@Html.DisplayFor(model => model.Height) decimeter - @Html.DisplayFor(model => model.Weight) hekto</p>
    <p>@Html.DisplayFor(model => model.Stats)</p>
    <p>Abilites:</p>
    <p>@Html.DisplayFor(model=> model.Abilites)</p>

    <p>@foreach (var ability in Model.Abilites)
        {
            <p>@ability</p>
        }
    </p>

</section>