@model Labb1_MVC.Models.Pokemon;

<section>
    <h2>@Html.DisplayFor(model => model.Name)</h2>
    <h3>@Html.DisplayFor(model => model.Type)</h3>
    <p>@Html.DisplayFor(model => model.Height) decimeter - @Html.DisplayFor(model => model.Weight) hekto</p>
    <p>Attack: @Model.Stats.FirstOrDefault(s => s.Stat?.Name == "attack")?.BaseStat</p>
    <p>Försvar: @Model.Stats.FirstOrDefault(s => s.Stat?.Name == "defense")?.BaseStat</p>
    <p>HP: @Model.Stats.FirstOrDefault(s => s.Stat?.Name == "hp")?.BaseStat</p>
    

</section>